# Copia este archivo a .env (o define las variables en el panel de Render).
# Ninguna es obligatoria: los valores por defecto sirven para desarrollo local.

# Puerto HTTP (Render lo inyecta automáticamente).
PORT=5000

# Orígenes permitidos por CORS, separados por coma. En producción pon el dominio real del frontend.
ALLOWED_ORIGINS=*

# Tamaño máximo de imagen aceptado, en MB. Debe coincidir con `maxUploadMb` del frontend.
MAX_UPLOAD_MB=10

# Máximo de píxeles (ancho × alto) que se aceptan al decodificar. Protege la memoria del servidor.
MAX_IMAGE_PIXELS=25000000

# Peticiones de predicción permitidas por IP (sintaxis de Flask-Limiter). 0/1 para desactivar.
RATE_LIMIT=30 per minute
RATE_LIMIT_ENABLED=1

# 1 si la API corre detrás de un proxy inverso (Render, Nginx): lee la IP real de X-Forwarded-For.
TRUST_PROXY=1

# 1 activa el modo debug de Flask. Nunca en producción.
FLASK_DEBUG=0
